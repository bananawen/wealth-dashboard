[Unit]
Description=Wealth FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lewis
Group=lewis
WorkingDirectory=/home/lewis/wealth/backend
EnvironmentFile=/home/lewis/wealth/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/lewis/wealth/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0002

[Install]
WantedBy=multi-user.target
